---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const meta = {
  title: `Delete your account — ${SITE.name}`,
  description:
    'How to delete your SOLVEQO account in the app or by contacting support@solveqo.com. Store subscriptions must be cancelled separately in Apple or Google settings.',
  path: '/delete-account',
};
---

<BaseLayout meta={meta}>
  <section class="page-shell">
    <div class="container container--narrow">
      <header class="page-header">
        <h1>Delete your SOLVEQO account</h1>
        <p>
          You can permanently delete your SOLVEQO account and associated account data. Read this
          page carefully before proceeding, especially if you have an active SOLVEQO Pro subscription.
        </p>
      </header>

      <div class="info-grid">
        <article class="info-card">
          <h2>Delete in the SOLVEQO app</h2>
          <p>The fastest way to delete your account is inside the mobile app:</p>
          <ol>
            <li>Open SOLVEQO and sign in.</li>
            <li>Go to <strong>Profile</strong> → <strong>Settings</strong>.</li>
            <li>Tap <strong>Delete account</strong> and follow the confirmation steps.</li>
          </ol>
          <p>
            Account deletion is permanent. It removes your SOLVEQO account and associated account
            data as described in our <a href="/privacy">Privacy Policy</a>.
          </p>
        </article>

        <article class="info-card warning-card">
          <h2>Important: App Store &amp; Google Play subscriptions</h2>
          <p>
            <strong>
              Deleting your SOLVEQO account does not automatically cancel an active SOLVEQO Pro
              subscription managed by Apple App Store or Google Play.
            </strong>
          </p>
          <p>
            SOLVEQO cannot directly cancel a subscription billed by Apple or Google on your behalf.
            If you have SOLVEQO Pro, you must manage or cancel the subscription separately through
            your Apple or Google account settings to avoid future charges.
          </p>
          <ul>
            <li>
              <strong>Apple:</strong> Settings → Apple ID → Subscriptions → SOLVEQO Pro
            </li>
            <li>
              <strong>Google Play:</strong> Google Play Store → Payments &amp; subscriptions →
              Subscriptions → SOLVEQO Pro
            </li>
          </ul>
          <p>
            You can also use <strong>Manage subscription</strong> in the SOLVEQO app (Settings) before
            deleting your account if you still have access.
          </p>
        </article>

        <article class="info-card">
          <h2>Cannot access the app?</h2>
          <p>
            If you cannot sign in or no longer have the app installed, contact us at
            <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>.
          </p>
          <p>
            Please email us from the address associated with your SOLVEQO account so we can verify
            your request. We may ask for additional information to protect your account.
          </p>
        </article>

        <article class="info-card">
          <h2>What happens after deletion</h2>
          <ul>
            <li>Your SOLVEQO login is removed and you will be signed out.</li>
            <li>
              Profile, jobs, messages, and other account data linked to your user are deleted according
              to our Privacy Policy.
            </li>
            <li>
              Uploaded files associated with your account (such as profile, portfolio, and job photos)
              are removed as part of the deletion process.
            </li>
            <li>
              Any active App Store or Google Play subscription may continue until you cancel it with
              Apple or Google.
            </li>
          </ul>
        </article>

        <article class="info-card">
          <h2>Related information</h2>
          <div class="link-list">
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
            <a href="/support">Support center</a>
            <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
