---
import { getTranslations, localePath, type Locale } from '../i18n';
import { SITE } from '../lib/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <strong>{SITE.name}</strong>
      <p style="margin: 0.75rem 0 0; max-width: 28rem; color: #bfdbfe;">
        {t.home.tagline} {t.footerTagline}
      </p>
      <p style="margin: 1rem 0 0;">
        <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>
      </p>
    </div>
    <div class="footer-links">
      {
        t.nav.map((link) => (
          <a href={localePath(locale, link.route)}>{link.label}</a>
        ))
      }
    </div>
  </div>
  <div class="container footer-meta">
    © {new Date().getFullYear()} {SITE.name}. {t.footerRights}
  </div>
</footer>
