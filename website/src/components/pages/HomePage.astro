---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, type Locale } from '../../i18n';
import { SITE } from '../../lib/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<BaseLayout locale={locale} route="home">
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">{t.home.eyebrow}</p>
        <div class="hero__title">
          <img
            class="hero__title-pin"
            src="/branding/pin-solveqo-blue.png"
            alt=""
            width="60"
            height="60"
            decoding="async"
          />
          <h1>{SITE.name}</h1>
        </div>
        <p class="hero__tagline">{t.home.tagline}</p>
        <p class="hero__lead">{t.home.lead1}</p>
        <p class="hero__lead">{t.home.lead2}</p>
      </div>
      <aside class="hero-card" aria-label={t.home.heroCardAria}>
        <img
          class="hero-card__logo"
          src="/branding/pin-solveqo.png"
          alt="SOLVEQO logo"
          width="88"
          height="88"
        />
        <h2>{t.home.heroCardTitle}</h2>
        <p>{t.home.heroCardBody}</p>
      </aside>
    </div>
  </section>

  <section class="container feature-grid" aria-label={t.home.featuresAria}>
    <article class="feature-card">
      <h3>{t.home.feature1Title}</h3>
      <p>{t.home.feature1Body}</p>
    </article>
    <article class="feature-card">
      <h3>{t.home.feature2Title}</h3>
      <p>{t.home.feature2Body}</p>
    </article>
    <article class="feature-card">
      <h3>{t.home.feature3Title}</h3>
      <p>{t.home.feature3Body}</p>
    </article>
  </section>

  <section class="container cta-strip">
    <h2>{t.home.ctaTitle}</h2>
    <p set:html={t.home.ctaBodyHtml} />
  </section>

  <section id="download" class="container download-section" aria-labelledby="download-heading">
    <div class="download-card">
      <img
        class="download-card__pin"
        src="/branding/pin-solveqo.png"
        alt=""
        width="56"
        height="56"
        decoding="async"
      />
      <div class="download-card__content">
        <h2 id="download-heading">{t.home.downloadTitle}</h2>
        <p>{t.home.downloadBody}</p>
        <div class="download-store-slots">
          <div class="store-slot store-slot--placeholder">{t.home.downloadStoreAppStore}</div>
          <div class="store-slot store-slot--placeholder">{t.home.downloadStoreGooglePlay}</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
