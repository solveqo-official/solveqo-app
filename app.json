{
  "expo": {
    "name": "SOLVEQO",
    "slug": "solveqo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "solveqo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aveliq.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SOLVEQO uses your location to show nearby jobs and center the map on your area."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.aveliq.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SOLVEQO uses your location to show nearby jobs and center the map on your area."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
